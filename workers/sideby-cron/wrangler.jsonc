{
  "$schema": "https://unpkg.com/wrangler@latest/config-schema.json",
  "name": "sideby-cron-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-01",
  "observability": {
    "enabled": true
  },
  "vars": {
    "SIDEBY_BASE_URL": "https://sideby.ink"
  },
  "triggers": {
    "crons": [
      "*/2 * * * *",
      "0 * * * *"
    ]
  }
}
